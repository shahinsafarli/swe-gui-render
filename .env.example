# =============================================================================
# Async Research Assistant — Environment Configuration
# =============================================================================
#
# HOW TO USE:
#   1. Copy this file:  cp .env.example .env
#   2. Fill in the values below that apply to your setup.
#   3. NEVER commit .env to version control — it contains secrets.
#
# The application reads these at startup via pydantic-settings.
# =============================================================================

# ---------------------------------------------------------------------------
# LLM provider — pick ONE block and fill in its key
# ---------------------------------------------------------------------------

# Google Gemini (generous free tier — no credit card for basic use)
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.0-flash
GOOGLE_API_KEY=                 # AIza...

# Anthropic (best quality for synthesis)
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-sonnet-4-6
# ANTHROPIC_API_KEY=            # sk-ant-...

# OpenAI (alternative)
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o-mini
# OPENAI_API_KEY=               # sk-...

# ---------------------------------------------------------------------------
# Web search provider — DuckDuckGo needs no key and works out of the box
# ---------------------------------------------------------------------------
WEB_SEARCH_PROVIDER=duckduckgo    # duckduckgo | tavily | serper

# Tavily (https://tavily.com — free 1 000 req/month, better quality)
# WEB_SEARCH_PROVIDER=tavily
# TAVILY_API_KEY=               # tvly-...

# Serper (https://serper.dev — free 2 500 req)
# WEB_SEARCH_PROVIDER=serper
# SERPER_API_KEY=

# ---------------------------------------------------------------------------
# PostgreSQL — OPTIONAL, only for `researcher history` command
# Leave this line as-is to skip history (safe — app fully works without DB).
# Replace YOUR_* with real values only if you want persistent history.
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://YOUR_DB_USER:YOUR_DB_PASSWORD@YOUR_DB_HOST:5432/YOUR_DB_NAME

# ---------------------------------------------------------------------------
# App behaviour
# ---------------------------------------------------------------------------
LOG_LEVEL=INFO                    # DEBUG | INFO | WARNING | ERROR
MAX_CONCURRENT=5                  # Semaphore bound for parallel source fetches
CACHE_TTL_SECONDS=3600            # Cache TTL in seconds; 0 = never expire

# ---------------------------------------------------------------------------
# Per-source timeouts (seconds)
# ---------------------------------------------------------------------------
WIKIPEDIA_TIMEOUT=10.0
ARXIV_TIMEOUT=15.0
WEB_TIMEOUT=10.0

# ---------------------------------------------------------------------------
# Limits
# ---------------------------------------------------------------------------
MAX_QUESTION_LENGTH=500           # Characters; longer questions are rejected
MAX_SOURCES=9                     # Max sources passed to the LLM synthesizer

# ---------------------------------------------------------------------------
# Docker Compose — DB credentials (used in docker-compose.yml only)
# Change these if you deploy somewhere other than localhost.
# ---------------------------------------------------------------------------
POSTGRES_USER=researcher_user
POSTGRES_PASSWORD=changeme
